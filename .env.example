# ELM/OpenAI reasoner. ELM uses the OpenAI SDK default endpoint; no base URL.
ELM_API_KEY=your-elm-api-key
BRAIN_MODEL=o3

# Gemini legacy HTTP endpoint, matching react-agent-avqa-optimize.
GEMINI_BASE_URL=https://api.apiplus.org
GEMINI_API_KEY=your-gemini-api-key
GEMINI_TIMEOUT=180
GEMINI_MAX_RETRIES=6
GEMINI_RETRY_DELAY_S=5
GEMINI_RETRY_MAX_DELAY_S=60
GEMINI_MAX_TOKENS=4096
